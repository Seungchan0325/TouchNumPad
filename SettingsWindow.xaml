<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TouchNumPad.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="설정">

    <Grid x:Name="RootGrid"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Custom Mica TitleBar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,0,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8EF;"
                          FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="TouchNumPad"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Windows 11 Settings Page Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="36,4,36,36">
            <StackPanel MaxWidth="800"
                        HorizontalAlignment="Stretch"
                        Spacing="24">

                <!-- Page Header -->
                <TextBlock Text="설정"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />

                <!-- Section 1: 모양 및 개인 설정 (Appearance & Personalization) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="모양 및 표시"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,6" />

                    <!-- SettingsCard: 앱 테마 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="68"
                            Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE790;"
                                      FontSize="20"
                                      Width="24"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="앱 테마"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="표시할 앱 테마 모드를 선택합니다"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="2"
                                      MinWidth="168"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="시스템 설정 사용" Tag="System" />
                                <ComboBoxItem Content="밝게" Tag="Light" />
                                <ComboBoxItem Content="어둡게" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- SettingsCard: 창 불투명도 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="68"
                            Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7A6;"
                                      FontSize="20"
                                      Width="24"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="창 불투명도"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="화면에 표시되는 넘패드 창의 투명도를 조절합니다"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="OpacityValueText"
                                           Text="95%"
                                           Width="40"
                                           TextAlignment="Right"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="OpacitySlider"
                                        Width="168"
                                        Maximum="100"
                                        Minimum="25"
                                        StepFrequency="5"
                                        Value="95"
                                        VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Section 2: 입력 및 단축키 (Input & Shortcuts) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="입력 및 단축키"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,6" />

                    <!-- SettingsCard: 활성화 단축키 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="68"
                            Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE765;"
                                      FontSize="20"
                                      Width="24"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="활성화 단축키"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="HotkeyStatusText"
                                           Text="넘패드 창을 열거나 닫는 전역 단축키입니다"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- PowerToys-style ShortcutControl Button -->
                            <Button x:Name="EditHotkeyButton"
                                    Grid.Column="2"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Padding="6,5"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="활성화 단축키 변경"
                                    Click="EditHotkeyButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <!-- KeyVisual Pills Container -->
                                    <StackPanel x:Name="KeycapsPanel"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center" />

                                    <FontIcon Glyph="&#xE70F;"
                                              FontSize="12"
                                              Margin="6,0,4,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- SettingsExpander: 터치패드 제스처 -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="True"
                              CornerRadius="4"
                              Padding="16,12">
                        <Expander.Header>
                            <Grid ColumnSpacing="16" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7C9;"
                                          FontSize="20"
                                          Width="24"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="터치패드 제스처 및 동작"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="터치패드 상단 슬라이드 제스처 및 터치 인식 규칙"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Spacing="12" Padding="40,4,8,4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="넘패드 열기"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="터치패드 상단을 왼쪽 끝에서 오른쪽 끝으로 쓸어내리기"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="넘패드 닫기"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="터치패드 상단을 오른쪽 끝에서 왼쪽 끝으로 쓸어내리기"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="일반 터치패드 작동"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="마우스 커서 이동(드래그), 더블 클릭, 두 손가락 이상 터치 시 자동 전환"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </StackPanel>

                <!-- Section 3: 정보 (About) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="정보"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,6" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="68"
                            Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE946;"
                                      FontSize="20"
                                      Width="24"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="TouchNumPad"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="랩탑 터치패드 넘패드 유틸리티"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="버전 1.0.0"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- PowerToys ShortcutDialogContentControl-style Shortcut Recorder Dialog -->
        <ContentDialog x:Name="HotkeyDialog"
                       Title="활성화 단축키"
                       PrimaryButtonText="저장"
                       CloseButtonText="취소"
                       DefaultButton="Primary"
                       Opened="HotkeyDialog_Opened"
                       PrimaryButtonClick="HotkeyDialog_PrimaryButtonClick"
                       Closing="HotkeyDialog_Closing">
            <Grid MinWidth="460"
                  MinHeight="220"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Instructions -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="키 조합을 눌러 이 단축키를 변경하세요"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Ctrl, Alt, Shift 또는 Win으로 시작하는 단축키만 유효합니다."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Recessed Key Stage -->
                <Border Grid.Row="1"
                        MinHeight="104"
                        Margin="0,12,0,0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel x:Name="DialogKeycapsPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                </Border>

                <!-- Row 2: Reset HyperlinkButton -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                    <HyperlinkButton x:Name="DialogResetButton"
                                     ToolTipService.ToolTip="기본 단축키(Shift + Alt + N)로 초기화"
                                     Click="DialogResetButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11"
                                      Glyph="&#xE777;"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="초기화"
                                       Margin="0,-1,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Row 3: Error / Warning InfoBars -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <InfoBar x:Name="DialogErrorInfoBar"
                             BorderThickness="0"
                             IsClosable="False"
                             IsOpen="False"
                             Severity="Error"
                             Message="유효하지 않은 단축키입니다. Ctrl, Alt, Shift 또는 Win 키와 다른 키를 조합하세요." />
                    <InfoBar x:Name="DialogWarningInfoBar"
                             BorderThickness="0"
                             IsClosable="False"
                             IsOpen="False"
                             Severity="Warning"
                             Message="Ctrl+Alt 조합은 일부 키보드 레이아웃에서 AltGr로 인식되어 작동하지 않을 수 있습니다." />
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
