<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TouchNumPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TouchNumPad">

    <!-- Clean Single-Border Mica Touchpad Canvas -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="6"
          PointerPressed="WindowSurface_PointerPressed"
          PointerMoved="WindowSurface_PointerMoved"
          PointerReleased="WindowSurface_PointerReleased"
          PointerCanceled="WindowSurface_PointerCanceled"
          DoubleTapped="RootGrid_DoubleTapped"
          SizeChanged="RootGrid_SizeChanged">

        <!-- Numpad Board: Rotates, Scales, and Translates like a photo in real-time -->
        <Grid x:Name="NumpadBoard"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BoardScaleTransform" />
                    <RotateTransform x:Name="BoardRotateTransform" />
                    <TranslateTransform x:Name="BoardTranslateTransform" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 5x4 Numpad Key Grid -->
            <Grid x:Name="KeysGrid"
                  RowSpacing="6"
                  ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>

        <!-- 1-Finger Touch Overlay Canvas (covers entire touchpad window space) -->
        <Canvas x:Name="TouchOverlayCanvas"
                IsHitTestVisible="False">
            <Grid x:Name="TouchIndicatorCircle"
                  Width="36"
                  Height="36"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Opacity="0.28" />
                <Ellipse Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                         StrokeThickness="2"
                         Opacity="0.90" />
                <Ellipse Width="10"
                         Height="10"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Opacity="0.98"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
        </Canvas>

        <!-- 2-Finger Multi-Touch Indicators (raw touchpad space) -->
        <Canvas x:Name="MultiTouchCanvas"
                IsHitTestVisible="False"
                Opacity="0">
            <!-- Finger 1 Indicator Circle -->
            <Grid x:Name="Finger1Indicator"
                  Width="36"
                  Height="36">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Opacity="0.28" />
                <Ellipse Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                         StrokeThickness="2"
                         Opacity="0.90" />
                <Ellipse Width="10"
                         Height="10"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- Finger 2 Indicator Circle -->
            <Grid x:Name="Finger2Indicator"
                  Width="36"
                  Height="36">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Opacity="0.28" />
                <Ellipse Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                         StrokeThickness="2"
                         Opacity="0.90" />
                <Ellipse Width="10"
                         Height="10"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
