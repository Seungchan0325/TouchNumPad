<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TouchNumPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TouchNumPad">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Borderless Header Strip (No System Title Bar) -->
        <Grid x:Name="HeaderBar"
              Grid.Row="0"
              Background="Transparent"
              Padding="12,0,6,0"
              PointerPressed="HeaderBar_PointerPressed"
              PointerMoved="HeaderBar_PointerMoved"
              PointerReleased="HeaderBar_PointerReleased"
              PointerCanceled="HeaderBar_PointerCanceled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title & Icon -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <FontIcon Glyph="&#xE8EF;"
                          FontSize="13"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="TouchNumPad"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Header Action Buttons (Settings & Close) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <Button x:Name="SettingsButton"
                        Width="30"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        ToolTipService.ToolTip="설정 (Settings)"
                        Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;"
                              FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button x:Name="CloseButton"
                        Width="30"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        ToolTipService.ToolTip="닫기 (일반 터치패드로 전환)"
                        Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE8BB;"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Numpad Surface -->
        <Grid x:Name="NumpadSurfaceGrid"
              Grid.Row="1"
              Background="Transparent"
              Margin="10,2,10,10"
              PointerPressed="NumpadSurfaceGrid_PointerPressed">

            <!-- 4x5 Numpad Key Grid -->
            <Grid x:Name="KeysGrid"
                  RowSpacing="6"
                  ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Accent Circle Overlay showing current finger position on the Numpad -->
            <Canvas x:Name="TouchOverlayCanvas"
                    IsHitTestVisible="False">
                <Grid x:Name="TouchIndicatorCircle"
                      Width="36"
                      Height="36"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                             Opacity="0.28" />
                    <Ellipse Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                             StrokeThickness="2"
                             Opacity="0.90" />
                    <Ellipse Width="10"
                             Height="10"
                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                             Opacity="0.98"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
